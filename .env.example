# Agentic AI Research & Fact-Checking Platform - Environment Configuration
# Copy this file to .env and configure your credentials

# ── Groq LLM (Required) ──────────────────────────────────────────────────────
# Get your free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the default Groq model (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ── Qdrant Cloud Vector Store ─────────────────────────────────────────────────
# Get your free cluster at https://cloud.qdrant.io
# If left blank, the platform automatically runs on local persistent Qdrant storage.
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=agentic_research_kb

# ── Agent Configuration ───────────────────────────────────────────────────────
# Maximum iteration loops for evidence gathering & replanning
MAX_AGENT_ITERATIONS=5
# Maximum unique external web sources to gather per research cycle
MAX_UNIQUE_SOURCES=8
# Maximum vector passages to retrieve from knowledge base per query
MAX_RAG_PASSAGES=6
# Maximum tool calls per research run
MAX_TOOL_CALLS=12

# ── Conversation Memory ───────────────────────────────────────────────────────
# Token budget for active conversation context window
MAX_CONVERSATION_TOKENS=3000
MAX_RECENT_TURNS=6

